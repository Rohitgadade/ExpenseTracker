@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Dashboard</h1>
        <p class="text-muted mb-0">A quick overview of your spending</p>
    </div>
    <a asp-controller="Expense" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Add Expense
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-2">Total spent this month</p>
                <h2 class="h3 mb-0">₹12,450.00</h2>
                <small class="text-muted">Across 18 expenses</small>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-2">Monthly budget</p>
                <h2 class="h3 mb-2">₹20,000.00</h2>
                <div class="progress" role="progressbar" aria-label="Budget used" aria-valuenow="62" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: 62%"></div>
                </div>
                <small class="text-muted">62% of budget used</small>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-2">Top category</p>
                <h2 class="h3 mb-0">Food &amp; Dining</h2>
                <small class="text-muted">₹4,250.00 this month</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h2 class="h5 mb-0">Recent expenses</h2>
                <a asp-controller="Expense" asp-action="Index" class="btn btn-sm btn-outline-primary">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Expense</th>
                            <th scope="col">Category</th>
                            <th scope="col">Date</th>
                            <th scope="col" class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Groceries</td>
                            <td>Food &amp; Dining</td>
                            <td>14 Nov 2026</td>
                            <td class="text-end">₹1,850.00</td>
                        </tr>
                        <tr>
                            <td>Electricity bill</td>
                            <td>Utilities</td>
                            <td>12 Nov 2026</td>
                            <td class="text-end">₹2,100.00</td>
                        </tr>
                        <tr>
                            <td>Bus pass</td>
                            <td>Transport</td>
                            <td>10 Nov 2026</td>
                            <td class="text-end">₹900.00</td>
                        </tr>
                        <tr>
                            <td>Lunch</td>
                            <td>Food &amp; Dining</td>
                            <td>09 Nov 2026</td>
                            <td class="text-end">₹450.00</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h2 class="h5 mb-0">Spending by category</h2>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1"><span>Food &amp; Dining</span><span>₹4,250</span></div>
                    <div class="progress" role="progressbar" aria-label="Food and dining spending" aria-valuenow="34" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width: 34%"></div></div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1"><span>Utilities</span><span>₹3,200</span></div>
                    <div class="progress" role="progressbar" aria-label="Utilities spending" aria-valuenow="26" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar bg-success" style="width: 26%"></div></div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1"><span>Transport</span><span>₹2,500</span></div>
                    <div class="progress" role="progressbar" aria-label="Transport spending" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar bg-info" style="width: 20%"></div></div>
                </div>
                <div>
                    <div class="d-flex justify-content-between mb-1"><span>Other</span><span>₹2,500</span></div>
                    <div class="progress" role="progressbar" aria-label="Other spending" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar bg-warning" style="width: 20%"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mt-4">
    <a asp-controller="Expense" asp-action="Index" class="btn btn-outline-secondary">Manage expenses</a>
    <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary">Manage categories</a>
</div>
