@model ExpenseTracker.ViewModels.DashboardViewModel

<h3 class="fw-bold mb-4">Dashboard</h3>

<div class="row g-4">

    <div class="col-md-3">
        <div class="card shadow-sm border-1 p-3">
            <h5 class="text-muted mb-2">Total Expenses</h5>
            <h3 class="fw-semibold">₹@Model.TotalSpend.ToString("N2")</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-1 p-3">
            <h5 class="text-muted mb-2">This Month Expenses</h5>
            <h3 class="fw-semibold">₹@Model.MonthlySpend.ToString("N2")</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-1 p-3">
            <h5 class="text-muted mb-2">Last Month Expenses</h5>
            <h3 class="fw-semibold">₹@Model.LastMonthlySpend.ToString("N2")</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-1 p-3">
            <h5 class="text-muted mb-2">Total Transactions</h5>
            <h3 class="fw-semibold">@Model.TotalTransactions</h3>
        </div>
    </div>

</div>

<style>
    .dashboard-chart-card {
        height: 100%;
        padding: 1.25rem;
        border: 1px solid #e8edf5;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 0.25rem 1rem rgba(31, 45, 61, 0.06);
    }

    .dashboard-chart-frame {
        position: relative;
        height: 320px;
    }

    @@media (max-width: 575.98px) {
        .dashboard-chart-frame {
            height: 280px;
        }
    }
</style>

<div class="row g-4 mt-2">
    <div class="col-lg-7">
        <section class="dashboard-chart-card" aria-labelledby="monthly-chart-title">
            <h5 id="monthly-chart-title" class="fw-bold mb-1">Monthly Expenses</h5>
            <p class="text-muted small mb-3">Spending overview for the year</p>
            <div class="dashboard-chart-frame">
                <canvas id="expenseChart" role="img" aria-label="Bar chart of monthly expenses"></canvas>
            </div>
        </section>
    </div>

    <div class="col-lg-5">
        <section class="dashboard-chart-card" aria-labelledby="category-chart-title">
            <h5 id="category-chart-title" class="fw-bold mb-1">Expense Categories</h5>
            <p class="text-muted small mb-3">Spending breakdown by category</p>
            <div class="dashboard-chart-frame">
                <canvas id="categoryChart" role="img" aria-label="Pie chart of expenses by category"></canvas>
            </div>
        </section>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const monthlyData = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(Model.MonthlyExpenses.Select(x => x.Total))
    );
    const categoryLabels = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(Model.CategoryExpenses.Select(x => x.Category))
    );
    const categoryData = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(Model.CategoryExpenses.Select(x => x.Total))
    );

    const chartColors = [
        '#4F46E5', '#06B6D4', '#10B981', '#F59E0B', '#EF4444', '#8B5CF6',
        '#EC4899', '#14B8A6', '#F97316', '#3B82F6', '#84CC16', '#A855F7'
    ];
    const chartJs = Reflect.get(window, 'Chart');

    new chartJs(document.getElementById('expenseChart'), {
        type: 'bar',
        data: {
            labels: [
                'January', 'February', 'March', 'April', 'May', 'June',
                'July', 'August', 'September', 'October', 'November', 'December'
            ],
            datasets: [{
                label: 'Expenses',
                data: monthlyData,
                backgroundColor: chartColors,
                borderRadius: 7,
                borderSkipped: false,
                maxBarThickness: 34
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false
            },
            plugins: {
                legend: { display: false }
            },
            scales: {
                x: {
                    grid: { display: false },
                    border: { display: false },
                    ticks: { color: '#64748B' }
                },
                y: {
                    beginAtZero: true,
                    border: { display: false },
                    grid: { color: '#EEF2F7' },
                    ticks: { color: '#64748B' }
                }
            }
        }
    });

    new chartJs(document.getElementById('categoryChart'), {
        type: 'pie',
        data: {
            labels: categoryLabels,
            datasets: [{
                label: 'Expenses',
                data: categoryData,
                backgroundColor: chartColors,
                borderColor: '#FFFFFF',
                borderWidth: 3,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            layout: { padding: 8 },
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        color: '#475569',
                        padding: 16,
                        usePointStyle: true,
                        pointStyle: 'circle'
                    }
                }
            }
        }
    });
</script>
