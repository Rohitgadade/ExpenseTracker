@model ExpenseTracker.Models.Category

@{
    ViewData["Title"] = "Delete Category Page";
}

<div class="container mt-4">

    <div class="row">
        <div class="col-md-6">

            <form asp-action="DeleteConfirm"
                  asp-controller="Category"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <h3 class="mb-3">Delete Category</h3>

                <h5 class="mb-3">
                    Are you sure you want to delete this
                    <span class="text-danger fw-bold">@Model.Name</span>
                    category?
                </h5>

                <button type="submit"
                        class="btn btn-sm btn-success me-3">
                    Yes
                </button>

                <a asp-action="Index"
                   asp-controller="Category"
                   class="btn btn-sm btn-secondary">
                    No
                </a>

            </form>

        </div>
    </div>

</div>
