@model IList<ExpenseTracker.Models.Category>

@{
	ViewData["Title"] = " Category Page";
}

<a asp-action="Create" asp-controller="Category" class="btn btn-primary btn-sm">Add Category</a>

<table class="table">
    <thead>
        <tr>
            <th scope="col"> Category Name </th>
            <th scope="col"> Actions </th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>
                        <a asp-action="Update" asp-controller="Category" asp-route-id="@category.Id" class="btn btn-secondary btn-sm">Update</a>
                        <a asp-action="Delete" asp-controller="Category" asp-route-id="@category.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>

            }
        }
        else{
              <tr>
                <td colspan="6" class="text-center">No category found.</td>
            </tr>
        }
    </tbody>
</table>