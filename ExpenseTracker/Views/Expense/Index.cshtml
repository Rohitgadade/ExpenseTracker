@model IList<ExpenseTracker.Models.Expense>

@{
    ViewData["Title"] = "Expense Page";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <a asp-action="Create" asp-controller="Expense" class="btn btn-primary">Add Expense</a>

    <form asp-action="Index" method="get" asp-controller="Expense" role="search">
        <div class="d-flex gap-2">
            <input type="search"
                   name="search"
                   value="@ViewBag.SearchTerm"
                   class="form-control"
                   placeholder="Search expenses..."
                   maxlength="50"
                   aria-label="Search expenses" />

            <select name="categoryId"
                    asp-items="(IEnumerable<SelectListItem>)ViewBag.Categories"
                    class="form-select"
                    aria-label="Filter by category">
                <option value="">All categories</option>
            </select>

            <button type="submit" class="btn btn-success">
                Search
            </button>

            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm) || ViewBag.CategoryId != null)
            {
                <a asp-action="Index" asp-controller="Expense" class="btn btn-outline-secondary">
                    Clear
                </a>
            }
        </div>
    </form>
</div>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Title</th>
            <th scope="col">Amount</th>
            <th scope="col">Date</th>
            <th scope="col">Category</th>
            <th scope="col">Description</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var expense in Model)
            {
                <tr>
                    <td>@expense.Title</td>
                    <td>₹@expense.Amount.ToString("N2")</td>
                    <td>@expense.Date?.ToString("dd-MM-yyyy")</td>
                    <td>@expense.Category?.Name</td>
                    <td>@expense.Description</td>
                    <td>
                        <div class="d-flex gap-4">
                            <a asp-action="Update" asp-controller="Expense" asp-route-id="@expense.Id" class="btn btn-warning ">Update</a>
                            <a asp-action="Delete" asp-controller="Expense" asp-route-id="@expense.Id" class="btn btn-danger ">Delete</a>
                         </div>
                     </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">No expenses found.</td>
            </tr>
        }
    </tbody>
</table>
